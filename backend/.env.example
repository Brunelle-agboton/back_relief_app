# =============================================================================
#  Configuration backend — copier en `.env` (jamais versionné)
#  Le détail prod / dev est documenté dans backend/PRODUCTION.md
# =============================================================================

# Mode d'exécution : DEV (dev + CI) | PROD (toute valeur ≠ DEV)
MODE=DEV

# Serveur
PORT=3000

# --- Base de données PostgreSQL ---------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=backrelief
POSTGRES_PASSWORD=change_me
POSTGRES_DATABASE=healthtracker

# --- JWT ---------------------------------------------------------------------
# Générer chaque secret avec :
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# JWT_SECRET est obligatoire (aucun repli en dur : le démarrage échoue s'il manque).
JWT_SECRET=change_me_with_a_long_random_secret
# JWT_REFRESH_SECRET est OBLIGATOIRE en production.
# En DEV, s'il est absent, JWT_SECRET est réutilisé.
JWT_REFRESH_SECRET=
# Durées de vie des jetons (format `ms`/`vercel/ms` : 15m, 1h, 30d…)
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# =============================================================================
#  Réglages dont la valeur DIFFÈRE entre dev et prod (mutualisation impossible)
#  Les valeurs ci-dessous sont les valeurs de DÉVELOPPEMENT.
#  Valeurs attendues en production : voir la colonne « PROD » de PRODUCTION.md
# =============================================================================

# Réécriture automatique du schéma par TypeORM.
# DEV : true — PROD : false (sauf tout premier déploiement, pour amorcer le schéma)
DB_SYNCHRONIZE=true

# Seed de démonstration au démarrage.
# DEV : true — PROD : false (ne jamais semer une base de production)
SEED_ON_BOOT=true

# Documentation Swagger exposée sur /api.
# DEV : true — PROD : false (expose toute la surface d'API)
SWAGGER_ENABLED=true

# Liste blanche CORS, séparée par des virgules.
# DEV : vide (= « * ») — PROD : liste explicite des origines web autorisées.
# L'application mobile n'envoie pas d'en-tête Origin, elle n'est pas concernée.
CORS_ORIGINS=

# --- Seed de développement uniquement (ignoré si SEED_ON_BOOT=false) ---------
# Compte praticien de démonstration. Sans ces variables, aucun compte n'est créé.
SEED_PRACTITIONER_EMAIL=practitioner@example.test
SEED_PRACTITIONER_PASSWORD=ChangeMe100!
SEED_PRACTITIONER_NAME=Praticien Démo
