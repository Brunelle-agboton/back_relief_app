# =============================================================================
#  Configuration backend — copier en `.env` (jamais versionné)
#  Le détail prod / dev est documenté dans backend/PRODUCTION.md
# =============================================================================

# Mode d'exécution : DEV (dev + CI) | PROD (toute valeur ≠ DEV)
MODE=DEV

# Serveur
PORT=3000

# --- Base de données PostgreSQL ---------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=backrelief
POSTGRES_PASSWORD=change_me
POSTGRES_DATABASE=healthtracker

# TLS de la connexion PostgreSQL : disable | require | verify-full
# DEV : disable — PROD : verify-full (défaut), qui exige POSTGRES_SSL_CA.
# `require` chiffre sans vérifier le certificat : à ne choisir qu'en connaissance
# de cause (réseau privé), jamais par défaut.
POSTGRES_SSL_MODE=disable
# Certificat CA au format PEM (retours à la ligne échappés \n acceptés).
POSTGRES_SSL_CA=

# --- JWT ---------------------------------------------------------------------
# Générer chaque secret avec :
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# JWT_SECRET est obligatoire (aucun repli en dur : le démarrage échoue s'il manque).
JWT_SECRET=change_me_with_a_long_random_secret
# JWT_REFRESH_SECRET est OBLIGATOIRE en production.
# En DEV, s'il est absent, JWT_SECRET est réutilisé.
JWT_REFRESH_SECRET=
# Durées de vie des jetons (format `ms`/`vercel/ms` : 15m, 1h, 30d…)
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# =============================================================================
#  Réglages dont la valeur DIFFÈRE entre dev et prod (mutualisation impossible)
#  Les valeurs ci-dessous sont les valeurs de DÉVELOPPEMENT.
#  Valeurs attendues en production : voir la colonne « PROD » de PRODUCTION.md
# =============================================================================

# Réécriture automatique du schéma par TypeORM.
# DEV : true (confort) — PROD : false, toujours. Le schéma de production est
# créé et fait évoluer par les migrations (`npm run migration:run`).
DB_SYNCHRONIZE=true

# Seed de démonstration au démarrage.
# DEV : true — PROD : false (ne jamais semer une base de production)
SEED_ON_BOOT=true

# Documentation Swagger exposée sur /api.
# DEV : true — PROD : false (expose toute la surface d'API)
SWAGGER_ENABLED=true

# Liste blanche CORS, séparée par des virgules.
# DEV : vide (= « * ») — PROD : liste explicite des origines web autorisées.
# L'application mobile n'envoie pas d'en-tête Origin, elle n'est pas concernée.
CORS_ORIGINS=

# Documentation Swagger protégée par authentification HTTP Basic.
# Obligatoire si SWAGGER_ENABLED=true en production (le démarrage échoue sinon).
SWAGGER_USER=
SWAGGER_PASSWORD=

# Nombre de proxys de confiance devant l'API (load balancer).
# DEV : 0 / absent — PROD : 1 sur Render. Indispensable pour que la limitation
# de débit distingue les utilisateurs au lieu de leur appliquer un quota commun.
TRUST_PROXY_HOPS=

# Quota global de requêtes, par adresse IP et par fenêtre.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Niveau de journalisation (pino) : fatal | error | warn | info | debug | trace
LOG_LEVEL=

# --- Praticien d'accueil -----------------------------------------------------
# Adresses interrogeables sans authentification via
# GET /practitioner-profile/by-email/:email (séparées par des virgules).
# Toute autre adresse reçoit 404 sans requête en base : pas d'énumération.
PUBLIC_PRACTITIONER_EMAILS=practitioner@example.test
# Praticien avec lequel le rendez-vous d'accueil est pris à l'inscription
# professionnelle. À défaut, la première entrée de PUBLIC_PRACTITIONER_EMAILS.
ONBOARDING_PRACTITIONER_EMAIL=practitioner@example.test

# --- Seed de développement uniquement (ignoré si SEED_ON_BOOT=false) ---------
# Compte praticien de démonstration. Sans ces variables, aucun compte n'est créé.
SEED_PRACTITIONER_EMAIL=practitioner@example.test
SEED_PRACTITIONER_PASSWORD=ChangeMe100!
SEED_PRACTITIONER_NAME=Praticien Démo
